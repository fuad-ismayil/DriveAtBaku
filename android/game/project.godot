; Shared native Windows and Android client. Assets come from the web project.
config_version=5

[application]
config/version="1.0.0"
config/name="DriveAtBaku"
config/description="Native driving in Baku"
config/icon="res://icon.png"
config/windows_native_icon="res://branding/app.ico"
boot_splash/image="res://branding/boot.png"
boot_splash/bg_color=Color(0.051, 0.09, 0.106, 1)
boot_splash/fullsize=false
boot_splash/use_filter=true
run/main_scene="res://main.tscn"
run/main_scene.network_verification="res://tests/network.tscn"
run/main_scene.visual_verification="res://tests/visual.tscn"
run/main_scene.feature_verification="res://tests/features.tscn"
run/main_scene.multiplayer_feature_verification="res://tests/multiplayer_features.tscn"
run/main_scene.audio_plate_verification="res://tests/audio_plate.tscn"
run/main_scene.interface_verification="res://tests/interface_flow.tscn"
run/main_scene.horn_verification="res://tests/horn_multiplayer.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/auto_accept_quit=false

[autoload]
Preferences="*res://scripts/preferences.gd"

[display]
window/size/viewport_width=1480
window/size/viewport_width.windows=1280
window/size/viewport_height=720
window/size/window_width_override=1480
window/size/window_width_override.windows=1280
window/size/window_height_override=720
window/size/min_width=960
window/size/min_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/aspect.mobile="keep"
window/handheld/orientation=0
window/vsync/vsync_mode=1

[input_devices]
pointing/emulate_touch_from_mouse=true
pointing/emulate_touch_from_mouse.windows=false
pointing/emulate_mouse_from_touch=true

[physics]
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
3d/default_gravity=0.0

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
textures/default_filters/anisotropic_filtering_level.windows=3
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.48, 0.65, 0.78, 1)
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/size.windows=4096
reflections/reflection_atlas/reflection_size=128
reflections/reflection_atlas/reflection_size.windows=256
reflections/reflection_atlas/reflection_size.mobile=128

[audio]
driver/enable_input=false
